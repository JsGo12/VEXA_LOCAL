# =====================================================================
# Vexa Local — archivos y carpetas que NO se suben al repositorio
# =====================================================================

# --- Python ---
__pycache__/
*.pyc
*.pyo
.venv/
venv/
env/
.pytest_cache/
*.egg-info/

# --- Empaquetado (PyInstaller) ---
build/
dist/
*.spec

# --- Variables de entorno y secretos ---
.env
.env.*
!.env.example

# --- Configuración local del usuario (PIN, archivos activos) ---
.vexa_local/

# --- Logs ---
logs/
*.log

# --- Editores / IDE ---
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo

# --- Sistema operativo / OneDrive ---
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

# --- Archivos temporales de Office (documentos abiertos) ---
~$*
*.tmp
