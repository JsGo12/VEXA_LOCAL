# Vexa Local: archivos locales y artefactos que no deben publicarse

# Python y pruebas
__pycache__/
*.py[cod]
*.pyd
.pytest_cache/
**/.pytest_*/
**/.pytest-*/
*.egg-info/

# Entornos locales
.venv/
venv/
env/

# Secretos y configuración local
.env
.env.*
!.env.example
.vexa_local/
instance/
case_documents/

# Bases de datos, índices, logs y respaldos locales
*.db
*.sqlite
*.sqlite3
*.log
*.bak

# Empaquetado
build/
dist/
*.spec
!VexaApp/desktop/backend/VexaBackend.spec
node_modules/
**/desktop/backend/build/
**/desktop/backend/dist/
**/desktop/electron/release/

# Editores / IDE
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo

# Sistema operativo / OneDrive
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

# Temporales de Office y archivos temporales
~$*
*.tmp
